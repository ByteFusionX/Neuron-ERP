# Session: short-lived access JWT + rotating refresh token (httpOnly cookie)
ACCESS_TOKEN_TTL = 15m
REFRESH_TOKEN_DAYS = 7
# Unset = lax locally, strict in production. lax/strict when the SPA and API share a site; "none" (needs HTTPS) when they are on different sites
COOKIE_SAMESITE = lax
